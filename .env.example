# Chave da API da Anthropic (Claude) para o assistente de IA.
# Crie em https://console.anthropic.com  →  copie este arquivo para ".env" e cole a chave abaixo.
ANTHROPIC_API_KEY=

# Modelo usado pelo assistente (opcional)
ANTHROPIC_MODEL=claude-opus-5

# Porta do servidor local (opcional)
EXCELENCIA_PORT=5180
